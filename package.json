{
  "name": "nikke-moba",
  "version": "0.1.0",
  "private": true,
  "description": "MOBA test bed with NIKKE chibi models in Babylon.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test:snow": "node --experimental-strip-types tools/test-snow.mjs",
    "test:snow-navigation": "node --experimental-strip-types tools/test-snow-navigation.mjs",
    "test:sortie": "node --experimental-strip-types tools/test-sortie.mjs",
    "test:progress": "node --experimental-strip-types tools/test-progress.mjs",
    "chibi": "node tools/fetch-chibi.mjs",
    "minions": "node tools/fetch-chibi.mjs --minions",
    "raptures": "python tools/convert-raptures.py",
    "raptures:extract": "python tools/extract-raptures.py"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0",
    "@fontsource/rajdhani": "^5.3.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.32.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "gltf-validator": "^2.0.0-dev.3.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
