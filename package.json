{
  "name": "nikke-moba",
  "version": "0.1.0",
  "private": true,
  "description": "MOBA test bed with NIKKE chibi models in Babylon.js",
  "type": "module",
  "scripts": {
    "test:storm": "node --experimental-strip-types tools/test-storm.mjs",
    "test:storm-browser": "node tools/verify-storm.mjs",
    "export:storm": "node tools/export-storm-kit.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test:snow": "node --experimental-strip-types tools/test-snow.mjs",
    "test:snow-navigation": "node --experimental-strip-types tools/test-snow-navigation.mjs",
    "test:sortie": "node --experimental-strip-types tools/test-sortie.mjs",
    "test:progress": "node --experimental-strip-types tools/test-progress.mjs",
    "test:survival": "node --experimental-strip-types tools/test-survival-round.mjs",
    "test:talents": "node --experimental-strip-types tools/test-talent-tiers.mjs",
    "test:save": "node --experimental-strip-types tools/test-save-data.mjs",
    "test:siege": "node --experimental-strip-types tools/test-siege.mjs",
    "chibi": "node tools/fetch-chibi.mjs",
    "minions": "node tools/fetch-chibi.mjs --minions",
    "raptures": "python tools/convert-raptures.py",
    "raptures:extract": "python tools/extract-raptures.py",
    "test:coop": "node --experimental-strip-types tools/test-coop-net.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dist": "node tools/sync-version.mjs && npm run build && electron-builder --win",
    "desktop:release": "node tools/sync-version.mjs && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@babylonjs/core": "^9.32.0",
    "@babylonjs/loaders": "^9.32.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@trystero-p2p/nostr": "0.26.0",
    "electron-updater": "^6.8.11",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.32.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "main": "desktop/main.cjs",
  "author": "ExportError",
  "build": {
    "appId": "com.exporterror.survivorsofvictory",
    "productName": "Survivors of Victory",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "dist/**",
      "package.json"
    ],
    "compression": "normal",
    "win": {
      "icon": "public/icon-sov-v1.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SurvivorsOfVictory-Setup-${version}.${ext}"
    },
    "nsis": {
      "installerIcon": "public/icon-sov-v1.ico",
      "uninstallerIcon": "public/icon-sov-v1.ico",
      "installerHeaderIcon": "public/icon-sov-v1.ico",
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Survivors of Victory 3D",
      "uninstallDisplayName": "Survivors of Victory 3D",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "exporterrormusic",
        "repo": "survivors-of-victory-3d",
        "releaseType": "release"
      }
    ]
  }
}
